name: HBO Override
desc: HBO
rule-providers:
  HBO:
    type: http
    behavior: classical
    url: https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/HBO/HBO.yaml
    interval: 86400

proxy-groups:
- name: 🎬 HBORule
  type: select
  proxies:
  - "🔰 手动选择"
  - "🎯 Direct"
  - "\U0001F30D 主流媒体"
  include-all-proxies: true
  # 匹配所有节点，确保像参考配置那样包含各国节点
  filter: .*

rules:
- RULE-SET,HBO,🎬 HBORule
